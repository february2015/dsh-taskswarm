{
  "name": "dsh-buju",
  "version": "0.1.0",
  "description": "Buju (布局) — multi-agent task orchestration for DeepSeek Harness. Native port of TaskPlane (github.com/HenryLach/taskplane, MIT): waves/lanes parallel execution, git worktree isolation, PROMPT.md/STATUS.md task packets, file mailbox, cross-model review.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "orchestration",
    "multi-agent",
    "task-runner",
    "parallel",
    "buju"
  ],
  "type": "module",
  "main": "lib/orchestrator/index.js",
  "types": "lib/orchestrator/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/orchestrator/index.d.ts",
      "default": "./lib/orchestrator/index.js"
    },
    "./orchestrator": {
      "types": "./lib/orchestrator/index.d.ts",
      "default": "./lib/orchestrator/index.js"
    },
    "./worker": {
      "types": "./lib/worker/index.d.ts",
      "default": "./lib/worker/index.js"
    },
    "./worker/startup": {
      "types": "./lib/worker/startup.d.ts",
      "default": "./lib/worker/startup.js"
    },
    "./worker/runner": {
      "types": "./lib/worker/runner.d.ts",
      "default": "./lib/worker/runner.js"
    },
    "./demo": {
      "types": "./lib/demo.d.ts",
      "default": "./lib/demo.js"
    },
    "./diag": {
      "types": "./lib/diag.d.ts",
      "default": "./lib/diag.js"
    },
    "./core/*": "./lib/core/*.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dashboard",
    "docs",
    "cordis.patch.yml",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.spec.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-default-model": "*",
    "@deepseek-ai/dsh-cmdline": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-tool-bash": "*",
    "@deepseek-ai/dsh-tool-fs": "*",
    "@deepseek-ai/dsh-tool-fs-search": "*",
    "@deepseek-ai/dsh-tool-str-replace-editor": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/cordis-plugin-loader": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-agent-default-model": { "optional": true },
    "@deepseek-ai/dsh-cmdline": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-tool-bash": { "optional": true },
    "@deepseek-ai/dsh-tool-fs": { "optional": true },
    "@deepseek-ai/dsh-tool-fs-search": { "optional": true },
    "@deepseek-ai/dsh-tool-str-replace-editor": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
